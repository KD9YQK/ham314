${offset 38}${voffset 21}${font1}${color1}FLDigi${offset 100}PAT
${offset 42}${voffset 21}${font1}${color1}Pulse${offset 100}Xastir

${if_running ardopc}${image /home/kd9yqk/ham314/conky/img/green_btn.png -s 128x32 -p 0,60}${else}${image /home/kd9yqk/ham314/conky/img/red_btn.png -s 128x32 -p 0,60}$endif
