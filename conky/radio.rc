conky.config = {
	background = true,
	use_xft = true,
	font = '123:size=8',
	xftalpha = 1.0,
	update_interval = 2.0,
	total_run_times = 0,
	own_window = true,
	own_window_type = 'normal',
	own_window_transparent = true,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
--        out_to_wayland = true,
        out_to_x = true,
	double_buffer = true,
	minimum_width = 260, minimum_height = 5,
	maximum_width = 260,
	draw_shades = true,
	draw_outline = false,
	draw_borders = true,
	draw_graph_borders = false,
	default_color = 'LightBlue',
	default_shade_color = 'black',
	default_outline_color = 'white',
	alignment = 'top_right',
	gap_x = 95,
	gap_y = 70,
	no_buffers = true,
	uppercase = false,
	cpu_avg_samples = 2,
	net_avg_samples = 1,
	override_utf8_locale = true,
	use_spacer = 'right',
        border_width = 0,
        lua_load = 'lua/radio.lua',
        lua_mouse_hook = 'mouse_handler',
        color1 = 'White',
        color2 = 'LightBlue',
        color3 = 'Red',
        color4 = 'Green',
        font1 = 'Arial:size=12',
        font2 = 'Arial:bold:size=14',
        font3 = 'Arial:bold:size=16',

};

