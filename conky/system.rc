conky.config = {
	background = true,
	use_xft = true,
	font = '123:size=8',
	xftalpha = 1.0,
	update_interval = 0.3,
	total_run_times = 0,
	own_window = true,
	own_window_type = 'normal',
	own_window_transparent = true,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
        out_to_wayland = true,
        out_to_console = false,
        out_to_stderr = false,
        out_to_x = true,
	double_buffer = true,
	minimum_width = 300, minimum_height = 5,
	maximum_width = 300,
	draw_shades = true,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = true,
	default_color = 'LightBlue',
	default_shade_color = 'black',
	default_outline_color = 'green',
	alignment = 'top_left',
	gap_x = 60,
	gap_y = 90,
	no_buffers = true,
	uppercase = false,
	cpu_avg_samples = 2,
	net_avg_samples = 1,
	override_utf8_locale = true,
	use_spacer = 'right',
        border_width = 2,
        top_name_verbose = true,
        top_name_width = 30,
        color1 = 'White',
        color2 = 'LightBlue',
};

conky.text = [[
${font Arial:size=14}${color2}${alignc}SYSTEM
${font Arial:bold:size=10}${color2}PROCESSOR ${color2} ${hr 2}
${font Arial:bold:size=10}${color1}Frequency $alignr${freq_g cpu0}Ghz
${font Arial:bold:size=10}${color1}Uptime $alignr${uptime}
#TEMP
${font Arial:bold:size=10}${color1}Temp: $alignr ${exec /usr/bin/vcgencmd measure_temp | awk -F "[=']" '{print($2 * 1.8)+32}'} F
${voffset -15}
${font Arial:bold:size=8}${color1}CPU 1${alignr}${cpu}%
${cpubar cpu1}
${font Arial:bold:size=8}${color1}CPU 2${alignr}${cpu}%
${cpubar cpu2}
${font Arial:bold:size=8}${color1}CPU 3${alignr}${cpu}%
${cpubar cpu3}
${font Arial:bold:size=8}${color1}CPU 4${alignr}${cpu}%
${cpubar cpu4}

${font Arial:bold:size=10}${color2}MEMORY ${color2} ${hr 2}
${font Arial:bold:size=8}${color1}MEM $alignc $mem / $memmax $alignr $memperc%
$membar
${font Arial:bold:size=8}${color1}SWAP $alignc $swap / $swapmax $alignr $swapperc%
$swapbar

${font Arial:bold:size=10}${color2}STORAGE ${color2} ${hr 2}
${font Arial:bold:size=8}${color1}HDD $alignc ${fs_used /home} / ${fs_size /home} $alignr ${fs_free_perc /home}%
${fs_bar /home}
${color2}DISK I/O: ${color1}${alignr}${diskio /dev/mmcblk0p2}
${color2}Read:
${diskiograph_read /dev/mmcblk0p2 20,300 White White 750}
${color2}Write:
${diskiograph_write /dev/mmcblk0p2 20,300 White White 750}

${font Arial:bold:size=10}${color2}NETWORK/HOTSPOT ${color2}${hr 2}
${font Arial:bold:size=10}${color1}Netrom address $alignr ${execi 2 ifconfig nr0 | awk '/netrom / {gsub("addr:", "", $2); print $2}'}${if_up nr0}
${font Arial:bold:size=10}${color1}Wireless IP address $alignr ${addr wlan0}${if_up wlan0}
${font Arial:bold:size=8}Up ${alignr}${upspeed wlan0}
${upspeedgraph wlan0 20,300 LightGreen White}
${font Arial:bold:size=8}down ${alignr}${downspeed wlan0}
${downspeedgraph wlan0 20,300 LightGreen White}$endif
${font Arial:bold:size=10}${color1}Wired IP address $alignr ${addr eth0}${if_up eth0}
${font Arial:bold:size=8}Up ${alignr}${upspeed eth0}
${upspeedgraph eth0 20,300 LightGreen White -t}
${font Arial:bold:size=8}down ${alignr}${downspeed eth0}
${downspeedgraph eth0 20,300 LightGreen White -t}$endif
${font Arial:bold:size=10}${color1}AX.25 address $alignr ${execi 2 ifconfig ax0 | awk '/ax25 / {gsub("addr:", "", $2); print $2}'}${if_up ax0}
${font Arial:bold:size=8}Up ${alignr}${upspeed ax0}
${upspeedgraph ax0 20,300 LightGreen White -t}
${font Arial:bold:size=8}down ${alignr}${downspeed ax0}
${downspeedgraph ax0 20,300 LightGreen White -t}$endif

${font Arial:bold:size=10}${color2}HOTSPOT DHCP ADDRESSES ${color2}${hr 2}
${font Arial:bold:size=10}${color1}${execi 5 cat /var/lib/misc/dnsmasq.leases | awk '{ print $3"   "$4 }'}

]];
