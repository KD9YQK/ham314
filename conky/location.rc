conky.config = {
	background = true,
	use_xft = true,
	font = '123:size=8',
	xftalpha = 1.0,
	update_interval = 1.0,
	total_run_times = 0,
	own_window = true,
	own_window_type = 'normal',
	own_window_transparent = true,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
--        out_to_wayland = true,
        out_to_x = true,
	double_buffer = true,
	minimum_width = 240, minimum_height = 5,
	maximum_width = 240,
	draw_shades = true,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,
	default_color = 'LightBlue',
	default_shade_color = 'black',
	default_outline_color = 'green',
	alignment = 'bottom_right',
	gap_x = 630,
	gap_y = 260,
	no_buffers = true,
	uppercase = false,
	cpu_avg_samples = 2,
	net_avg_samples = 1,
	override_utf8_locale = true,
	use_spacer = 'right',
        border_width = 2,
        draw_graph_borders = true,
        lua_load = 'lua/location.lua',
        lua_mouse_hook = 'mouse_handler',
        color1 = White,
        color2 = LightBlue,
};

conky.text = [[

${font Arial:size=24}${color2}${alignc}KD9YQK
#${voffset -25}
${hr 2}
#${font Arial:bold:size=12}${color1}Gridsquare ${alignr}${color Yellow}${execi 60 cat /run/user/1000/gridinfo.txt | cut -c1-8}
${font Arial:bold:size=12}${color2}Gridsquare ${alignr}${color1}${execpi 2 awk NR==1 ~/loc.dat}
${font Arial:bold:size=12}${color2}Lat: ${alignr}${color1}${execpi 2 awk NR==2 ~/loc.dat}
${font Arial:bold:size=12}${color2}Lon: ${alignr}${color1}${execpi 2 awk NR==3 ~/loc.dat}

]];
