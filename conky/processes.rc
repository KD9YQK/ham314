conky.config = {
	background = true,
	use_xft = true,
	font = '123:size=8',
	xftalpha = 1.0,
	update_interval = 1.0,
	total_run_times = 0,
	own_window = true,
	own_window_type = 'normal',
	own_window_transparent = true,
	own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
        out_to_wayland = true,
        out_to_x = false,
	double_buffer = true,
	minimum_width = 575, minimum_height = 5,
	maximum_width = 575,
	draw_shades = true,
	draw_outline = false,
	draw_borders = true,
	draw_graph_borders = false,
	default_color = 'LightBlue',
	default_shade_color = 'black',
	default_outline_color = 'green',
	alignment = 'top_right',
	gap_x = 460,
	gap_y = 80,
	no_buffers = true,
	uppercase = false,
	cpu_avg_samples = 2,
	net_avg_samples = 1,
	override_utf8_locale = true,
	use_spacer = 'right',
        border_width = 0,
        draw_graph_borders = true,
        top_name_width = 80,
        top_name_verbose = true,
        color1 = White,
        color2 = LightBlue,
};

conky.text = [[
${font Arial:size=14}${color LightBlue}${alignc}PROCESSES
${font Arial:bold:size=10}${color LightBlue}Total: ${alignr}${color White}${processes}

${font Arial:bold:size=10}${color LightBlue}CPU ${color LightBlue} ${hr 2}
${font Arial:bold:size=8}${color White}${top name 1}${alignr}${top cpu 1} %
${font Arial:bold:size=8}${color White}${top name 2}${alignr}${top cpu 2} %
${font Arial:bold:size=8}${color White}${top name 3}${alignr}${top cpu 3} %
${font Arial:bold:size=8}${color White}${top name 4}${alignr}${top cpu 4} %
${font Arial:bold:size=8}${color White}${top name 5}${alignr}${top cpu 5} %
${font Arial:bold:size=8}${color White}${top name 6}${alignr}${top cpu 6} %
${font Arial:bold:size=8}${color White}${top name 7}${alignr}${top cpu 7} %
${font Arial:bold:size=8}${color White}${top name 8}${alignr}${top cpu 8} %
${font Arial:bold:size=8}${color White}${top name 9}${alignr}${top cpu 9} %
${font Arial:bold:size=8}${color White}${top name 10}${alignr}${top cpu 10} %

${font Arial:bold:size=10}${color LightBlue}MEM ${color LightBlue} ${hr 2}
${font Arial:bold:size=8}${color White}${top_mem name 1}${alignr}${top mem 1} %
${font Arial:bold:size=8}${color White}${top_mem name 2}${alignr}${top mem 2} %
${font Arial:bold:size=8}${color White}${top_mem name 3}${alignr}${top mem 3} %
${font Arial:bold:size=8}${color White}${top_mem name 4}${alignr}${top mem 4} %
${font Arial:bold:size=8}${color White}${top_mem name 5}${alignr}${top mem 5} %
${font Arial:bold:size=8}${color White}${top_mem name 6}${alignr}${top mem 6} %
${font Arial:bold:size=8}${color White}${top_mem name 7}${alignr}${top mem 7} %
${font Arial:bold:size=8}${color White}${top_mem name 8}${alignr}${top mem 8} %
${font Arial:bold:size=8}${color White}${top_mem name 9}${alignr}${top mem 9} %
${font Arial:bold:size=8}${color White}${top_mem name 10}${alignr}${top mem 10} %

]];
